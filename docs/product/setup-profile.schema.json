{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agenstart:setup-profile:v2",
  "title": "AgenStart setup profile",
  "description": "v1 uses profileId. v2 uses profileIds and may still include profileId as the first selected profile for older desktop readers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "createdAtUtc",
    "applications"
  ],
  "properties": {
    "kind": {
      "const": "agenstart.setup"
    },
    "schemaVersion": {
      "enum": [1, 2]
    },
    "createdAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "profileId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
    },
    "profileIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
      }
    },
    "applications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["applicationId"],
        "properties": {
          "applicationId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
          },
          "reason": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "agenStartVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": 1 } }, "required": ["schemaVersion"] },
      "then": { "required": ["profileId"] }
    },
    {
      "if": { "properties": { "schemaVersion": { "const": 2 } }, "required": ["schemaVersion"] },
      "then": { "required": ["profileIds"] }
    }
  ]
}
