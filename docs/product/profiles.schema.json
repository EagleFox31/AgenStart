{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agenstart:profiles:v1",
  "title": "AgenStart usage-profile registry v1",
  "description": "Single source of truth for usage profiles (ADR-0003). Referential integrity with the software catalogue is enforced by the loader and tests.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profiles"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "profileId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,39}$"
    },
    "localizedText": {
      "type": "object",
      "required": ["en"],
      "propertyNames": { "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "order", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/profileId" },
        "status": { "enum": ["active", "planned", "retired"] },
        "order": { "type": "integer", "minimum": 0 },
        "icon": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/profileId" }
        },
        "label": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "reasonLabel": { "$ref": "#/$defs/localizedText" }
      },
      "if": { "properties": { "status": { "const": "active" } } },
      "then": { "required": ["description", "reasonLabel"] }
    }
  }
}
