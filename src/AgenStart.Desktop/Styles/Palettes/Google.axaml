<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Google palette: Material 3 light, tonal pill navigation, outlined rounded cards. Every theme defines the same keys. -->
