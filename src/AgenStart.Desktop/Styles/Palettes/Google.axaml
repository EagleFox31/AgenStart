  <FontFamily x:Key="AgenFontFamily">Google Sans, Roboto, Segoe UI Variable Text, Segoe UI</FontFamily>
  <BoxShadows x:Key="AgenCardShadow">0 1 2 0 #0D000000</BoxShadows>
  <Thickness x:Key="AgenCardBorderThickness">1</Thickness>
  <CornerRadius x:Key="AgenSmallRadius">12</CornerRadius>
  <CornerRadius x:Key="AgenCardRadius">16</CornerRadius>
  <CornerRadius x:Key="AgenButtonRadius">20</CornerRadius>
  <CornerRadius x:Key="AgenBadgeRadius">8</CornerRadius>
  <CornerRadius x:Key="AgenNavItemRadius">18</CornerRadius>
  <CornerRadius x:Key="AgenGroupRadius">16</CornerRadius>
  <CornerRadius x:Key="AgenHeroRadius">24</CornerRadius>
  <CornerRadius x:Key="AgenTileRadius">16</CornerRadius>
  <Thickness x:Key="AgenNavItemMargin">0,1</Thickness>
  <Thickness x:Key="AgenNavItemPadding">16,0</Thickness>
  <x:Double x:Key="AgenNavItemHeight">36</x:Double>
