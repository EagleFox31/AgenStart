  <SolidColorBrush x:Key="AgenNavBrush" Color="#EFEFF2" />
  <Color x:Key="AgenNavHoverColor">#1F787880</Color>
  <SolidColorBrush x:Key="AgenNavHoverBrush" Color="#1F787880" />
  <Color x:Key="AgenNavActiveColor">#2E787880</Color>
