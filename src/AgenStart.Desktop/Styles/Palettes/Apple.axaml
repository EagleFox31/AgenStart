<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Apple palette: macOS grouped settings, translucent-grey sidebar, white grouped cards with soft shadows. Every theme defines the same keys. -->
