  <x:String x:Key="AgenThemeVariant">Light</x:String>
  <FontFamily x:Key="AgenFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
  <BoxShadows x:Key="AgenCardShadow">0 1 2 0 #0A000000, 0 8 24 0 #0F000000</BoxShadows>
  <Thickness x:Key="AgenCardBorderThickness">0</Thickness>
  <CornerRadius x:Key="AgenSmallRadius">8</CornerRadius>
  <CornerRadius x:Key="AgenCardRadius">14</CornerRadius>
  <CornerRadius x:Key="AgenButtonRadius">8</CornerRadius>
  <CornerRadius x:Key="AgenBadgeRadius">10</CornerRadius>
  <CornerRadius x:Key="AgenNavItemRadius">8</CornerRadius>
  <CornerRadius x:Key="AgenGroupRadius">12</CornerRadius>
  <CornerRadius x:Key="AgenHeroRadius">16</CornerRadius>
  <CornerRadius x:Key="AgenTileRadius">14</CornerRadius>
  <Thickness x:Key="AgenNavItemMargin">0,1</Thickness>
  <Thickness x:Key="AgenNavItemPadding">10,0</Thickness>
  <x:Double x:Key="AgenNavItemHeight">32</x:Double>
