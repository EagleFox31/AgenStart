  <SolidColorBrush x:Key="AgenNavIconActiveBrush" Color="#0071E3" />
  <Color x:Key="AgenNavHeadingColor">#8E8E93</Color>
  <SolidColorBrush x:Key="AgenNavHeadingBrush" Color="#8E8E93" />
