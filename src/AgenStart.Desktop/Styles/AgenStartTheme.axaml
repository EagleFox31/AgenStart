<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Colours, fonts and radii come from the active palette in Styles/Palettes/,
       swapped at runtime by ThemeService; always reference them with DynamicResource. -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource AgenSurfaceBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource AgenFontFamily}" />
    <Setter Property="Foreground" Value="{DynamicResource AgenTextBrush}" />
  </Style>

  <Style Selector="Border.navStripe">
    <Setter Property="Width" Value="3" />
    <Setter Property="Height" Value="42" />
    <Setter Property="Background" Value="{DynamicResource AgenNavStripeBrush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="CornerRadius" Value="0,3,3,0" />
  </Style>

  <Style Selector="Button.nav">
    <Setter Property="Height" Value="52" />
    <Setter Property="Margin" Value="{DynamicResource AgenNavItemMargin}" />
    <Setter Property="Padding" Value="{DynamicResource AgenNavItemPadding}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AgenNavTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource AgenNavItemRadius}" />
    <Setter Property="FontSize" Value="16" />
  </Style>

  <Style Selector="Button.nav:pointerover">
    <Setter Property="Background" Value="{DynamicResource AgenNavHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AgenNavTextHoverBrush}" />
  </Style>

  <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AgenNavHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AgenNavTextHoverBrush}" />
  </Style>

  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="{DynamicResource AgenNavActiveBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AgenNavTextActiveBrush}" />
  </Style>

  <Style Selector="Button.nav.active /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AgenNavActiveBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AgenNavTextActiveBrush}" />
  </Style>

  <Style Selector="Button.nav:disabled">
    <Setter Property="Opacity" Value="0.42" />
    <Setter Property="Foreground" Value="{DynamicResource AgenNavTextDisabledBrush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.nav:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AgenNavTextDisabledBrush}" />
  </Style>

  <Style Selector="Button.nav:disabled:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource AgenNavTextDisabledBrush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.nav:disabled:pointerover /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource AgenNavTextDisabledBrush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="MinWidth" Value="220" />
    <Setter Property="Height" Value="54" />
    <Setter Property="Padding" Value="24,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource AgenTealBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AgenOnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource AgenButtonRadius}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.primary /template/ ContentPresenter">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AgenPrimaryHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AgenOnAccentBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="MinWidth" Value="190" />
    <Setter Property="Height" Value="54" />
    <Setter Property="Padding" Value="22,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AgenTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AgenSecondaryBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource AgenButtonRadius}" />
    <Setter Property="FontSize" Value="16" />
  </Style>

  <Style Selector="Button.secondary /template/ ContentPresenter">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.secondary:pointerover">
    <Setter Property="Background" Value="{DynamicResource AgenSecondaryHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AgenTextBrush}" />
  </Style>

  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AgenSecondaryHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AgenTextBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="RadioButton.profileCard">
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AgenTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AgenDividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource AgenSmallRadius}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="RadioButton.profileCard:pointerover">
    <Setter Property="Background" Value="{DynamicResource AgenProfileHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AgenTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AgenProfileHoverBorderBrush}" />
  </Style>

  <Style Selector="RadioButton.profileCard:checked">
    <Setter Property="Background" Value="{DynamicResource AgenSoftTealBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AgenTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AgenTealBrush}" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>

  <Style Selector="TextBlock.eyebrow">
    <Setter Property="Foreground" Value="{DynamicResource AgenTealBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LetterSpacing" Value="2" />
  </Style>

  <Style Selector="TextBlock.pageTitle">
    <Setter Property="Foreground" Value="{DynamicResource AgenTextBrush}" />
    <Setter Property="FontSize" Value="48" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.subtitle">
    <Setter Property="Foreground" Value="{DynamicResource AgenMutedBrush}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="LineHeight" Value="25" />
  </Style>

  <Style Selector="Border.dataRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource AgenDividerBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="8,13" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Border.dataRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource AgenProfileHoverBrush}" />
  </Style>

  <Style Selector="Border.dataRow TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.dataRow TextBlock.rowIcon">
    <Setter Property="Width" Value="28" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource AgenTextBrush}" />
  </Style>

  <Style Selector="Button.nav TextBlock.navIcon">
    <Setter Property="Width" Value="34" />
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="FontFamily" Value="Segoe UI Symbol" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style Selector="Button.nav TextBlock.navLabel">
    <Setter Property="Margin" Value="12,0,0,0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Failure counters turn red only when something actually failed. -->
  <Style Selector="TextBlock.failedMetric.hasFailures">
    <Setter Property="Foreground" Value="{DynamicResource AgenDangerBrush}" />
  </Style>

  <!-- Confirm step: apps to install stand out from those already present. -->
  <Style Selector="TextBlock.planStatus">
    <Setter Property="Foreground" Value="{DynamicResource AgenMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.planStatus.willInstall">
    <Setter Property="Foreground" Value="{DynamicResource AgenTealBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Border.notice">
    <Setter Property="Background" Value="{DynamicResource AgenBadgeSoftWarningBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AgenBadgeWarningBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource AgenSmallRadius}" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style Selector="Border.statusBadge">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource AgenBadgeRadius}" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.statusBadge.success">
    <Setter Property="Background" Value="{DynamicResource AgenSoftSuccessBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AgenBadgeSuccessBorderBrush}" />
  </Style>

  <Style Selector="Border.statusBadge.success TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AgenBadgeSuccessBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.statusBadge.warning">
    <Setter Property="Background" Value="{DynamicResource AgenBadgeSoftWarningBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AgenBadgeWarningBorderBrush}" />
  </Style>

  <Style Selector="Border.statusBadge.warning TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AgenBadgeWarningBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.statusBadge.danger">
    <Setter Property="Background" Value="{DynamicResource AgenBadgeSoftDangerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AgenBadgeDangerBorderBrush}" />
  </Style>

  <Style Selector="Border.statusBadge.danger TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AgenBadgeDangerBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
