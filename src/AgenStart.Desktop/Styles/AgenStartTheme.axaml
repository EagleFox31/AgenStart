<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Component styles for the grouped, light AgenStart look.
       Colours, fonts, radii, shadows and density come from the active palette in
       Styles/Palettes/, swapped at runtime by ThemeService: always use DynamicResource. -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource AgenSurfaceBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource AgenFontFamily}" />
    <Setter Property="Foreground" Value="{DynamicResource AgenTextBrush}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- ───── Sidebar ───── -->

  <Style Selector="Border.sidebar">
    <Setter Property="Background" Value="{DynamicResource AgenNavBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AgenSidebarBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <Style Selector="TextBlock.navHeading">
    <Setter Property="Foreground" Value="{DynamicResource AgenNavHeadingBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="10,18,10,6" />
  </Style>

  <Style Selector="Button.nav">
    <Setter Property="Height" Value="{DynamicResource AgenNavItemHeight}" />
    <Setter Property="Margin" Value="{DynamicResource AgenNavItemMargin}" />
    <Setter Property="Padding" Value="{DynamicResource AgenNavItemPadding}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AgenNavTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource AgenNavItemRadius}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AgenNavHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AgenNavTextHoverBrush}" />
  </Style>

  <Style Selector="Button.nav:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AgenNavActiveBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AgenNavTextActiveBrush}" />
  </Style>

  <Style Selector="Button.nav.active /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AgenNavActiveBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AgenNavTextActiveBrush}" />
  </Style>

  <Style Selector="Button.nav.active TextBlock.navLabel">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.nav.active TextBlock.navIcon">
    <Setter Property="Foreground" Value="{DynamicResource AgenNavIconActiveBrush}" />
  </Style>

  <Style Selector="Button.nav:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector="Button.nav:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AgenNavTextDisabledBrush}" />
  </Style>

  <Style Selector="Button.nav TextBlock.navIcon">
    <Setter Property="Width" Value="20" />
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{DynamicResource AgenNavIconBrush}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.nav TextBlock.navLabel">
    <Setter Property="Margin" Value="10,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ───── Typography ───── -->

  <Style Selector="TextBlock.eyebrow">
    <Setter Property="Foreground" Value="{DynamicResource AgenHeroTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBlock.pageTitle">
    <Setter Property="Foreground" Value="{DynamicResource AgenTextBrush}" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.4" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.subtitle">
    <Setter Property="Foreground" Value="{DynamicResource AgenMutedBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.sectionHeader">
    <Setter Property="Foreground" Value="{DynamicResource AgenMutedBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="4,0,0,8" />
  </Style>

  <Style Selector="TextBlock.rowTitle">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="TextBlock.rowHint">
    <Setter Property="Foreground" Value="{DynamicResource AgenMutedBrush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.rowCaption">
    <Setter Property="Foreground" Value="{DynamicResource AgenText3Brush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="TextBlock.hint">
    <Setter Property="Foreground" Value="{DynamicResource AgenMutedBrush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.statValue">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.4" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>

  <Style Selector="TextBlock.statLabel">
    <Setter Property="Foreground" Value="{DynamicResource AgenMutedBrush}" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <Style Selector="TextBlock.glyph">
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{DynamicResource AgenAccentBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ───── Surfaces ───── -->

  <!-- Grouped card: white container holding rows separated by hairlines. -->
  <Style Selector="Border.group">
    <Setter Property="Background" Value="{DynamicResource AgenCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AgenCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource AgenCardBorderThickness}" />
    <Setter Property="CornerRadius" Value="{DynamicResource AgenGroupRadius}" />
    <Setter Property="BoxShadow" Value="{DynamicResource AgenCardShadow}" />
  </Style>

  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{DynamicResource AgenCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AgenCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource AgenCardBorderThickness}" />
    <Setter Property="CornerRadius" Value="{DynamicResource AgenTileRadius}" />
    <Setter Property="BoxShadow" Value="{DynamicResource AgenCardShadow}" />
    <Setter Property="Padding" Value="18,16" />
  </Style>

  <Style Selector="Border.hero">
    <Setter Property="Background" Value="{DynamicResource AgenHeroBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource AgenHeroRadius}" />
    <Setter Property="Padding" Value="28,26" />
  </Style>

  <Style Selector="Border.row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource AgenSeparatorBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="16,11" />
    <Setter Property="MinHeight" Value="48" />
  </Style>

  <!-- The last row of a group has no trailing hairline. -->
  <Style Selector="Border.row:nth-last-child(1)">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ContentPresenter:nth-last-child(1) > Border.row">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Border.iconTile">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="{DynamicResource AgenSmallRadius}" />
    <Setter Property="Background" Value="{DynamicResource AgenIconTileBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.statusCircle">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="Background" Value="{DynamicResource AgenSoftSuccessBrush}" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style Selector="Border.statusCircle TextBlock">
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource AgenSuccessBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.statusCircle.warning">
    <Setter Property="Background" Value="{DynamicResource AgenSoftWarningBrush}" />
  </Style>

  <Style Selector="Border.statusCircle.warning TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AgenWarningBrush}" />
  </Style>

  <Style Selector="Border.notice">
    <Setter Property="Background" Value="{DynamicResource AgenBadgeSoftWarningBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource AgenGroupRadius}" />
    <Setter Property="Padding" Value="16,14" />
  </Style>

  <!-- Kept for compatibility with views that still use plain rows. -->
  <Style Selector="Border.dataRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource AgenSeparatorBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="16,11" />
  </Style>

  <!-- ───── Buttons ───── -->

  <Style Selector="Button.primary, Button.secondary, Button.plain">
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource AgenButtonRadius}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <Style Selector="Button.large">
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="FontSize" Value="14.5" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AgenAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AgenOnAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AgenPrimaryHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AgenOnAccentBrush}" />
  </Style>

  <Style Selector="Button.primary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AgenPrimaryPressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AgenOnAccentBrush}" />
  </Style>

  <Style Selector="Button.primary:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AgenAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AgenOnAccentBrush}" />
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource AgenFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AgenSecondaryTextBrush}" />
  </Style>

  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter, Button.secondary:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AgenFillHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AgenSecondaryTextBrush}" />
  </Style>

  <Style Selector="Button.secondary:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AgenFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AgenSecondaryTextBrush}" />
  </Style>

  <Style Selector="Button.plain">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AgenAccentBrush}" />
  </Style>

  <Style Selector="Button.plain:pointerover /template/ ContentPresenter, Button.plain:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AgenFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AgenAccentBrush}" />
  </Style>

  <Style Selector="Button.primary:disabled, Button.secondary:disabled, Button.plain:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- ───── Segmented control ───── -->

  <Style Selector="Border.segmented">
    <Setter Property="Background" Value="{DynamicResource AgenFillBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource AgenButtonRadius}" />
    <Setter Property="Padding" Value="2" />
  </Style>

  <Style Selector="Button.segment">
    <Setter Property="Height" Value="28" />
    <Setter Property="MinWidth" Value="36" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource AgenButtonRadius}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AgenMutedBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.segment:pointerover /template/ ContentPresenter, Button.segment:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AgenFillHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AgenTextBrush}" />
  </Style>

  <Style Selector="Button.segment.active">
    <Setter Property="Background" Value="{DynamicResource AgenCardBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AgenAccentBrush}" />
  </Style>

  <Style Selector="Button.segment.active:pointerover /template/ ContentPresenter, Button.segment.active:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AgenCardBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AgenAccentBrush}" />
  </Style>

  <!-- ───── Inputs ───── -->

  <Style Selector="RadioButton.profileCard">
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource AgenTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AgenDividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource AgenSmallRadius}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="RadioButton.profileCard:checked">
    <Setter Property="Background" Value="{DynamicResource AgenSoftTealBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AgenAccentBrush}" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource AgenFillBrush}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="{DynamicResource AgenSmallRadius}" />
  </Style>

  <!-- ───── Status ───── -->

  <!-- Failure counters turn red only when something actually failed. -->
  <Style Selector="TextBlock.failedMetric.hasFailures">
    <Setter Property="Foreground" Value="{DynamicResource AgenDangerBrush}" />
  </Style>

  <!-- Confirm step: apps to install stand out from those already present. -->
  <Style Selector="TextBlock.planStatus">
    <Setter Property="Foreground" Value="{DynamicResource AgenMutedBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBlock.planStatus.willInstall">
    <Setter Property="Foreground" Value="{DynamicResource AgenAccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Border.statusBadge">
    <Setter Property="CornerRadius" Value="{DynamicResource AgenBadgeRadius}" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.statusBadge TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.statusBadge.success">
    <Setter Property="Background" Value="{DynamicResource AgenSoftSuccessBrush}" />
  </Style>

  <Style Selector="Border.statusBadge.success TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AgenBadgeSuccessBrush}" />
  </Style>

  <Style Selector="Border.statusBadge.warning">
    <Setter Property="Background" Value="{DynamicResource AgenBadgeSoftWarningBrush}" />
  </Style>

  <Style Selector="Border.statusBadge.warning TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AgenBadgeWarningBrush}" />
  </Style>

  <Style Selector="Border.statusBadge.danger">
    <Setter Property="Background" Value="{DynamicResource AgenBadgeSoftDangerBrush}" />
  </Style>

  <Style Selector="Border.statusBadge.danger TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AgenBadgeDangerBrush}" />
  </Style>
</Styles>
