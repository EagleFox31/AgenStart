<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgenStart.Desktop.ViewModels"
             xmlns:views="using:AgenStart.Desktop.Views"
             x:Class="AgenStart.Desktop.Views.UsageProfilesView"
             x:DataType="views:UsageProfilesView">
  <Grid ColumnDefinitions="1.45*,0.55*" ColumnSpacing="50">
    <StackPanel Grid.Column="0" Spacing="10">
      <TextBlock Text="Choose how you use this PC" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,4" />
      <TextBlock Text="Select one or more uses. AgenStart merges them, removes duplicates, and only preselects the strongest matches." Foreground="{StaticResource AgenMutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10" />

      <ItemsControl ItemsSource="{Binding Options}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ProfileOptionViewModel">
            <Border BorderBrush="{StaticResource AgenDividerBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
              <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="ProfileCheckBox_OnClick">
                <StackPanel>
                  <TextBlock Text="{Binding Label}" FontSize="17" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Description}" Foreground="{StaticResource AgenMutedBrush}" FontSize="13" TextWrapping="Wrap" />
                </StackPanel>
              </CheckBox>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,8,0,0">
        <Button x:Name="BuildButton" Classes="primary" Content="Build my recommendations" Click="BuildButton_OnClick" />
        <Button x:Name="BackButton" Classes="secondary" Content="Back" Click="BackButton_OnClick" />
      </StackPanel>

      <Border x:Name="RecommendationProgressHost"
              IsVisible="False"
              BorderBrush="{StaticResource AgenDividerBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="16,13"
              Margin="0,8,0,0"
              Background="#FBFAF6">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <TextBlock x:Name="RecommendationProgressLabel" Text="Starting recommendation analysis…" Foreground="{StaticResource AgenMutedBrush}" FontSize="13" />
            <TextBlock x:Name="RecommendationProgressPercent" Grid.Column="1" Text="10%" Foreground="{StaticResource AgenTealBrush}" FontSize="13" FontWeight="SemiBold" />
          </Grid>
          <ProgressBar x:Name="RecommendationProgressBar" Minimum="0" Maximum="100" Value="10" Height="6" IsIndeterminate="False" />
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="310" Spacing="12">
      <Border Width="70" Height="70" CornerRadius="35" BorderThickness="2" BorderBrush="{StaticResource AgenTealBrush}" HorizontalAlignment="Center"><TextBlock Text="✦" Foreground="{StaticResource AgenTealBrush}" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
      <TextBlock Text="Selected uses" Foreground="{StaticResource AgenMutedBrush}" TextAlignment="Center" Margin="0,8,0,0" />
      <TextBlock x:Name="SelectedProfilesText" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
      <Border Height="1" Background="{StaticResource AgenDividerBrush}" Margin="0,8" />
      <TextBlock Text="AgenStart combines these profiles, deduplicates apps and keeps gems optional by default." Classes="subtitle" TextWrapping="Wrap" TextAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>
