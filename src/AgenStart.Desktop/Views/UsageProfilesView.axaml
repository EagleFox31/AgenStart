<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgenStart.Desktop.ViewModels"
             xmlns:views="using:AgenStart.Desktop.Views"
             x:Class="AgenStart.Desktop.Views.UsageProfilesView"
             x:DataType="views:UsageProfilesView">
  <Grid x:Name="RootGrid" RowDefinitions="Auto,*" ColumnDefinitions="*,260" ColumnSpacing="20" RowSpacing="24">
    <StackPanel Grid.ColumnSpan="2">
      <TextBlock Classes="pageTitle" Text="{DynamicResource Usage.HowDoYouUseThis}" />
      <TextBlock Classes="subtitle" Text="{DynamicResource Usage.SelectOneOrMoreUses}" Margin="0,6,0,0" />
    </StackPanel>

    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="16">
      <Border Classes="group">
        <ItemsControl ItemsSource="{Binding Options}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ProfileOptionViewModel">
              <Border Classes="row" Padding="16,12">
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="ProfileCheckBox_OnClick" HorizontalAlignment="Stretch">
                  <StackPanel Margin="4,0,0,0">
                    <TextBlock Classes="rowTitle" Text="{Binding Label}" />
                    <TextBlock Classes="rowHint" Text="{Binding Description}" />
                  </StackPanel>
                </CheckBox>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <Border x:Name="RecommendationProgressHost" Classes="tile" IsVisible="False" Padding="16,14">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <TextBlock x:Name="RecommendationProgressLabel" Text="{DynamicResource Usage.StartingRecommendationAnalysis}" Foreground="{DynamicResource AgenMutedBrush}" FontSize="13" />
            <TextBlock x:Name="RecommendationProgressPercent" Grid.Column="1" Text="10%" Foreground="{DynamicResource AgenAccentBrush}" FontSize="13" FontWeight="SemiBold" />
          </Grid>
          <ProgressBar x:Name="RecommendationProgressBar" Minimum="0" Maximum="100" Value="10" IsIndeterminate="False" />
        </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="BuildButton" Classes="primary large" Content="{DynamicResource Usage.BuildMyRecommendations}" Click="BuildButton_OnClick" />
        <Button x:Name="BackButton" Classes="secondary large" Content="{DynamicResource Usage.Back}" Click="BackButton_OnClick" />
      </StackPanel>
    </StackPanel>

    <Border Grid.Row="1" Grid.Column="1" Classes="hero" Padding="20,20" VerticalAlignment="Top">
      <StackPanel Spacing="6">
        <TextBlock Classes="eyebrow" Text="{DynamicResource Usage.SelectedUses}" />
        <TextBlock x:Name="SelectedProfilesText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Classes="hint" Text="{DynamicResource Usage.AgenStartCombinesTheseProfilesDeduplicates}" Margin="0,6,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
