<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AgenStart.Desktop.LocalData"
             x:Class="AgenStart.Desktop.Views.HistoryView"
             x:DataType="local:LocalExperienceViewModel">
  <StackPanel Spacing="24">
    <StackPanel>
      <TextBlock Classes="pageTitle" Text="{DynamicResource History.SetupHistory}" />
      <TextBlock Classes="subtitle" Text="{DynamicResource History.PreviousAgenStartSetupSessionsStored}" Margin="0,6,0,0" />
    </StackPanel>

    <Grid ColumnDefinitions="*,300" ColumnSpacing="20">
      <StackPanel>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="sectionHeader" Text="{DynamicResource History.Sessions}" />
          <TextBlock Grid.Column="1" Classes="rowCaption" Text="{DynamicResource History.LocalOnly}" VerticalAlignment="Center" Margin="0,0,4,8" />
        </Grid>
        <Border Classes="group">
          <Grid>
            <ListBox ItemsSource="{Binding HistoryEntries}" SelectedItem="{Binding SelectedHistory, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:SetupHistoryRowViewModel">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" Margin="2,4">
                    <StackPanel>
                      <TextBlock Classes="rowTitle" Text="{Binding ApplicationSummary}" />
                      <TextBlock Classes="rowHint" Text="{Binding Outcome}" />
                      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <TextBlock Text="{Binding CompletedAt}" Foreground="{DynamicResource AgenText3Brush}" FontSize="12" />
                        <TextBlock Text="{Binding Profile}" Foreground="{DynamicResource AgenAccentBrush}" FontSize="12" FontWeight="Medium" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding InstalledSummary}" FontSize="13" TextAlignment="Right" />
                      <TextBlock Text="{Binding FailedSummary}" Foreground="{DynamicResource AgenMutedBrush}" FontSize="12" TextAlignment="Right" Margin="0,2,0,0" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Border IsVisible="{Binding !HistoryEntries.Count}" Padding="20,28">
              <StackPanel Spacing="10" HorizontalAlignment="Center">
                <Border Classes="iconTile" HorizontalAlignment="Center" Width="44" Height="44"><TextBlock Classes="glyph" Text="&#xE81C;" FontSize="20" /></Border>
                <TextBlock Text="{DynamicResource History.NoSetupsYet}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Classes="rowHint" Text="{DynamicResource History.CompletedInstallationsWillAppearHere}" TextAlignment="Center" MaxWidth="380" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </StackPanel>

      <StackPanel Grid.Column="1">
        <TextBlock Classes="sectionHeader" Text="{DynamicResource History.SessionDetails}" />
        <Border Classes="tile" IsVisible="{Binding SelectedHistory, Converter={x:Static ObjectConverters.IsNull}}">
          <TextBlock Classes="rowHint" Text="{DynamicResource History.SelectASessionToSee}" Margin="0" />
        </Border>
        <Border Classes="tile" IsVisible="{Binding SelectedHistory, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Spacing="12">
            <StackPanel>
              <TextBlock Text="{Binding SelectedHistory.Profile}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Classes="rowCaption" Text="{Binding SelectedHistory.CompletedAt}" Margin="0,2,0,0" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*">
              <StackPanel><TextBlock Classes="statValue" Text="{Binding SelectedHistory.ProcessedCount}" Foreground="{DynamicResource AgenAccentBrush}" /><TextBlock Classes="statLabel" Text="{DynamicResource History.Processed}" /></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Classes="statValue" Text="{Binding SelectedHistory.FailedCount}" /><TextBlock Classes="statLabel" Text="{DynamicResource History.Failed}" /></StackPanel>
            </Grid>
            <Border Height="1" Background="{DynamicResource AgenSeparatorBrush}" />
            <TextBlock Text="{DynamicResource History.Applications}" FontWeight="SemiBold" />
            <ItemsControl ItemsSource="{Binding SelectedHistory.Applications}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:SetupHistoryApplication">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,4">
                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Result}" Foreground="{DynamicResource AgenMutedBrush}" FontSize="13" TextAlignment="Right" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="secondary" Content="{DynamicResource History.ExportSetup}" IsEnabled="{Binding CanExportSelectedHistory}" Click="ExportSetupButton_OnClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,4,0,0" />
            <TextBlock Classes="hint" Text="{DynamicResource History.ExportsPortableAgenStartApplicationIDs}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
