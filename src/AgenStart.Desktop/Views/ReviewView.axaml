<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgenStart.Desktop.ViewModels"
             xmlns:views="using:AgenStart.Desktop.Views"
             x:Class="AgenStart.Desktop.Views.ReviewView"
             xmlns:steps="using:AgenStart.Desktop.ViewModels.Steps"
             x:DataType="steps:ReviewViewModel">
  <StackPanel Spacing="24">
    <StackPanel>
      <TextBlock Classes="pageTitle" Text="Confirm your setup" />
      <TextBlock Classes="subtitle" Text="Nothing will be installed until you approve this plan." Margin="0,6,0,0" />
    </StackPanel>

    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
      <Border Classes="tile"><StackPanel><TextBlock Classes="statValue" Text="{Binding ReviewTotalCount}" /><TextBlock Classes="statLabel" Text="in plan" /></StackPanel></Border>
      <Border Grid.Column="1" Classes="tile"><StackPanel><TextBlock Classes="statValue" Text="{Binding ReviewAlreadyInstalledCount}" /><TextBlock Classes="statLabel" Text="already installed" /></StackPanel></Border>
      <Border Grid.Column="2" Classes="tile"><StackPanel><TextBlock Classes="statValue" Text="{Binding ReviewInstallCount}" Foreground="{DynamicResource AgenAccentBrush}" /><TextBlock Classes="statLabel" Text="to install" /></StackPanel></Border>
    </Grid>

    <Border Classes="group">
      <ItemsControl ItemsSource="{Binding ReviewItems}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ReviewRowViewModel">
            <Border Classes="row" Padding="14,10">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
                <views:AppRowLogoView VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Classes="rowTitle" Text="{Binding Name}" />
                  <TextBlock Text="{Binding Reason}" Foreground="{DynamicResource AgenMutedBrush}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="2" Classes="planStatus" Classes.willInstall="{Binding !AlreadyInstalled}" Text="{Binding Status}" VerticalAlignment="Center" />
                <Button Grid.Column="3" Classes="plain" Content="Remove" IsVisible="{Binding CanRemove}" Click="RemoveButton_OnClick" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <Border Classes="group" Padding="16,14">
      <CheckBox IsChecked="{Binding AgreementsAccepted, Mode=TwoWay}">
        <StackPanel Margin="4,0,0,0">
          <TextBlock Text="Allow WinGet to accept required package and source agreements for this approved setup." FontWeight="Medium" TextWrapping="Wrap" />
          <TextBlock Classes="rowHint" Text="Only the applications listed above are eligible for installation." />
        </StackPanel>
      </CheckBox>
    </Border>

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <TextBlock Classes="hint" Text="AgenStart will install only the applications shown above." VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Classes="secondary large" Content="Back to recommendations" Click="BackButton_OnClick" />
        <Button Classes="primary large" Content="Start installation" IsEnabled="{Binding CanStartInstallation}" Click="StartButton_OnClick" />
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
