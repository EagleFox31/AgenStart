<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AgenStart.Desktop.LocalData"
             x:Class="AgenStart.Desktop.Views.SettingsView"
             x:DataType="local:LocalExperienceViewModel">
  <StackPanel Spacing="24">
    <StackPanel>
      <TextBlock Classes="pageTitle" Text="{DynamicResource Settings.Settings}" />
      <TextBlock Classes="subtitle" Text="{DynamicResource Settings.ControlHowAgenStartBehavesOn}" Margin="0,6,0,0" />
    </StackPanel>

    <StackPanel>
      <TextBlock Classes="sectionHeader" Text="{DynamicResource Settings.General}" />
      <Border Classes="group">
        <StackPanel>
          <Border Classes="row">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
              <Border Classes="iconTile"><TextBlock Classes="glyph" Text="&#xE9D9;" /></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="rowTitle" Text="{DynamicResource Settings.AnalyseThisPCWhenAgenStart}" />
                <TextBlock Classes="rowHint" Text="{DynamicResource Settings.RunsTheSameReadOnly}" />
              </StackPanel>
              <CheckBox Grid.Column="2" IsChecked="{Binding AnalyzeOnStartup, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0" />
            </Grid>
          </Border>
          <Border Classes="row">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
              <Border Classes="iconTile"><TextBlock Classes="glyph" Text="&#xE790;" /></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="rowTitle" Text="{DynamicResource Settings.Theme}" />
                <TextBlock Classes="rowHint" Text="{DynamicResource Settings.ChooseTheLookOfAgenStart}" />
              </StackPanel>
              <ComboBox Grid.Column="2" MinWidth="170" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Settings.Theme}" />
            </Grid>
          </Border>
          <Border Classes="row">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
              <Border Classes="iconTile"><TextBlock Classes="glyph" Text="&#xE775;" /></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="rowTitle" Text="{DynamicResource Settings.Language}" />
                <TextBlock Classes="rowHint" Text="{DynamicResource Settings.ChooseTheLanguage}" />
              </StackPanel>
              <ComboBox Grid.Column="2" MinWidth="170" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Settings.Language}" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel>
      <TextBlock Classes="sectionHeader" Text="{DynamicResource Settings.Installation}" />
      <Border Classes="group">
        <StackPanel>
          <Border Classes="row">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
              <Border Classes="iconTile"><TextBlock Classes="glyph" Text="&#xE7B8;" /></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="rowTitle" Text="{DynamicResource Settings.PackageProvider}" />
                <TextBlock Classes="rowHint" Text="{DynamicResource Settings.ExactCataloguePackageIdentitiesAre}" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="WinGet" Foreground="{DynamicResource AgenMutedBrush}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Classes="row">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
              <Border Classes="iconTile"><TextBlock Classes="glyph" Text="&#xE8D7;" /></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="rowTitle" Text="{DynamicResource Settings.PackageAgreements}" />
                <TextBlock Classes="rowHint" Text="{DynamicResource Settings.AgenStartRequiresExplicitApprovalOn}" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{DynamicResource Settings.Required}" Foreground="{DynamicResource AgenMutedBrush}" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel>
      <TextBlock Classes="sectionHeader" Text="{DynamicResource Settings.Privacy}" />
      <Border Classes="group">
        <StackPanel>
          <Border Classes="row">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
              <Border Classes="iconTile"><TextBlock Classes="glyph" Text="&#xE9D2;" /></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="rowTitle" Text="{DynamicResource Settings.AnonymousProductAnalytics}" />
                <TextBlock Classes="rowHint" Text="{DynamicResource Settings.NotAvailableYetNoTelemetry}" />
              </StackPanel>
              <CheckBox Grid.Column="2" IsChecked="False" IsEnabled="{Binding TelemetryAvailable}" VerticalAlignment="Center" MinWidth="0" />
            </Grid>
          </Border>
          <Border Classes="row">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
              <Border Classes="iconTile"><TextBlock Classes="glyph" Text="&#xE74D;" /></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="rowTitle" Text="{DynamicResource Settings.LocalAgenStartData}" />
                <TextBlock Classes="rowHint" Text="{DynamicResource Settings.HistoryAndPreferencesAreStored}" />
              </StackPanel>
              <Button Grid.Column="2" Classes="secondary" Content="{DynamicResource Settings.ClearLocalData}" Click="ClearLocalDataButton_OnClick" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="notice" IsVisible="{Binding ClearConfirmationVisible}" Margin="0,12,0,0">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
          <StackPanel>
            <TextBlock Text="{DynamicResource Settings.ClearLocalAgenStartData}" FontWeight="SemiBold" />
            <TextBlock Classes="rowHint" Text="{DynamicResource Settings.ThisRemovesSetupHistoryAnd}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="secondary" Content="{DynamicResource Settings.Cancel}" Click="CancelClearButton_OnClick" />
            <Button Classes="primary" Content="{DynamicResource Settings.Clear}" Click="ConfirmClearButton_OnClick" />
          </StackPanel>
        </Grid>
      </Border>
      <TextBlock Classes="hint" Text="{Binding StorageStatus}" Margin="4,8,0,0" />
    </StackPanel>

    <StackPanel>
      <TextBlock Classes="sectionHeader" Text="{DynamicResource Settings.SetupProfiles}" />
      <Border Classes="group">
        <StackPanel>
        <Border Classes="row">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <Border Classes="iconTile"><TextBlock Classes="glyph" Text="&#xE8B7;" /></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Classes="rowTitle" Text="{DynamicResource Settings.ManageExportedSetups}" />
              <TextBlock Classes="rowHint" Text="{DynamicResource Settings.ReusableImportExportProfilesWill}" />
            </StackPanel>
            <Button Grid.Column="2" Classes="secondary" Content="{DynamicResource Settings.Manage}" IsEnabled="{Binding ExportManagementAvailable}" VerticalAlignment="Center" />
          </Grid>
        </Border>
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel>
      <TextBlock Classes="sectionHeader" Text="{DynamicResource Settings.About}" />
      <Border Classes="group">
        <StackPanel>
        <Border Classes="row" Padding="16,14">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <Border Width="40" Height="40" CornerRadius="10" ClipToBounds="True" VerticalAlignment="Center"><Image Source="avares://AgenStart.Desktop/Assets/agenstart-app-icon.png" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" /></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="AgenStart" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Classes="rowHint" Text="0.1.0-alpha · BY AGENSTUDIO" />
              <TextBlock Classes="rowHint" Text="{DynamicResource Settings.ThinkSharpBuildWhatMatters}" />
            </StackPanel>
            <Border Grid.Column="2" Classes="statusBadge success" VerticalAlignment="Center"><TextBlock Text="{DynamicResource Settings.LocalFirst}" /></Border>
          </Grid>
        </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
