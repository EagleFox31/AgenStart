<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AgenStart.Desktop.LocalData"
             x:Class="AgenStart.Desktop.Views.SettingsView"
             x:DataType="local:LocalExperienceViewModel">
  <StackPanel Spacing="24">
    <StackPanel>
      <TextBlock Classes="pageTitle" Text="Settings" />
      <TextBlock Classes="subtitle" Text="Control how AgenStart behaves on this device." Margin="0,6,0,0" />
    </StackPanel>

    <StackPanel>
      <TextBlock Classes="sectionHeader" Text="General" />
      <Border Classes="group">
        <StackPanel>
          <Border Classes="row">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
              <Border Classes="iconTile"><TextBlock Classes="glyph" Text="&#xE9D9;" /></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="rowTitle" Text="Analyse this PC when AgenStart starts" />
                <TextBlock Classes="rowHint" Text="Runs the same read-only local capability scan used by Your PC." />
              </StackPanel>
              <CheckBox Grid.Column="2" IsChecked="{Binding AnalyzeOnStartup, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0" />
            </Grid>
          </Border>
          <Border Classes="row">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
              <Border Classes="iconTile"><TextBlock Classes="glyph" Text="&#xE790;" /></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="rowTitle" Text="Theme" />
                <TextBlock Classes="rowHint" Text="Choose the look of AgenStart. The change applies immediately and is saved on this device." />
              </StackPanel>
              <ComboBox Grid.Column="2" MinWidth="170" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Theme" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel>
      <TextBlock Classes="sectionHeader" Text="Installation" />
      <Border Classes="group">
        <StackPanel>
          <Border Classes="row">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
              <Border Classes="iconTile"><TextBlock Classes="glyph" Text="&#xE7B8;" /></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="rowTitle" Text="Package provider" />
                <TextBlock Classes="rowHint" Text="Exact catalogue package identities are resolved through WinGet." />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="WinGet" Foreground="{DynamicResource AgenMutedBrush}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Classes="row">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
              <Border Classes="iconTile"><TextBlock Classes="glyph" Text="&#xE8D7;" /></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="rowTitle" Text="Package agreements" />
                <TextBlock Classes="rowHint" Text="AgenStart requires explicit approval on the Review screen before accepting provider agreements." />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="Required" Foreground="{DynamicResource AgenMutedBrush}" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel>
      <TextBlock Classes="sectionHeader" Text="Privacy" />
      <Border Classes="group">
        <StackPanel>
          <Border Classes="row">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
              <Border Classes="iconTile"><TextBlock Classes="glyph" Text="&#xE9D2;" /></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="rowTitle" Text="Anonymous product analytics" />
                <TextBlock Classes="rowHint" Text="Not available yet. No telemetry is sent by this build. Privacy-first telemetry is tracked in #15." />
              </StackPanel>
              <CheckBox Grid.Column="2" IsChecked="False" IsEnabled="{Binding TelemetryAvailable}" VerticalAlignment="Center" MinWidth="0" />
            </Grid>
          </Border>
          <Border Classes="row">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
              <Border Classes="iconTile"><TextBlock Classes="glyph" Text="&#xE74D;" /></Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="rowTitle" Text="Local AgenStart data" />
                <TextBlock Classes="rowHint" Text="History and preferences are stored only in AgenStart's local application-data folder." />
              </StackPanel>
              <Button Grid.Column="2" Classes="secondary" Content="Clear local data" Click="ClearLocalDataButton_OnClick" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="notice" IsVisible="{Binding ClearConfirmationVisible}" Margin="0,12,0,0">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
          <StackPanel>
            <TextBlock Text="Clear local AgenStart data?" FontWeight="SemiBold" />
            <TextBlock Classes="rowHint" Text="This removes setup history and resets local preferences. Installed applications are not touched." />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="secondary" Content="Cancel" Click="CancelClearButton_OnClick" />
            <Button Classes="primary" Content="Clear" Click="ConfirmClearButton_OnClick" />
          </StackPanel>
        </Grid>
      </Border>
      <TextBlock Classes="hint" Text="{Binding StorageStatus}" Margin="4,8,0,0" />
    </StackPanel>

    <StackPanel>
      <TextBlock Classes="sectionHeader" Text="Setup profiles" />
      <Border Classes="group">
        <StackPanel>
        <Border Classes="row">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <Border Classes="iconTile"><TextBlock Classes="glyph" Text="&#xE8B7;" /></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Classes="rowTitle" Text="Manage exported setups" />
              <TextBlock Classes="rowHint" Text="Reusable import/export profiles will be enabled by milestone #9." />
            </StackPanel>
            <Button Grid.Column="2" Classes="secondary" Content="Manage" IsEnabled="{Binding ExportManagementAvailable}" VerticalAlignment="Center" />
          </Grid>
        </Border>
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel>
      <TextBlock Classes="sectionHeader" Text="About" />
      <Border Classes="group">
        <StackPanel>
        <Border Classes="row" Padding="16,14">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <Border Width="40" Height="40" CornerRadius="10" ClipToBounds="True" VerticalAlignment="Center"><Image Source="avares://AgenStart.Desktop/Assets/agenstart-app-icon.png" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" /></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="AgenStart" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Classes="rowHint" Text="0.1.0-alpha · BY AGENSTUDIO" />
              <TextBlock Classes="rowHint" Text="Think sharp. Build what matters." />
            </StackPanel>
            <Border Grid.Column="2" Classes="statusBadge success" VerticalAlignment="Center"><TextBlock Text="Local-first" /></Border>
          </Grid>
        </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
