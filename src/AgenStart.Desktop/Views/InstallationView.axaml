<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgenStart.Desktop.ViewModels"
             xmlns:views="using:AgenStart.Desktop.Views"
             x:Class="AgenStart.Desktop.Views.InstallationView"
             xmlns:steps="using:AgenStart.Desktop.ViewModels.Steps"
             x:DataType="steps:InstallationViewModel">
  <StackPanel Spacing="24">
    <StackPanel>
      <TextBlock Classes="pageTitle" Text="{DynamicResource Install.SettingUpYourPC}" />
      <TextBlock Classes="subtitle" Text="{Binding InstallationStatus}" Margin="0,6,0,0" />
    </StackPanel>

    <Border Classes="hero" Padding="24,20">
      <StackPanel Spacing="10">
        <TextBlock Classes="eyebrow" Text="{DynamicResource Install.CurrentTask}" />
        <TextBlock Text="{Binding CurrentInstallationName}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsInstalling}" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
          <Button Classes="secondary" Content="{DynamicResource Install.CancelInstallation}" IsEnabled="{Binding IsInstalling}" Click="CancelButton_OnClick" />
          <Button Classes="primary" Content="{DynamicResource Install.ViewReport}" IsVisible="{Binding HasReport}" Click="ViewReportButton_OnClick" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
      <Border Classes="tile"><StackPanel><TextBlock Classes="statValue" Text="{Binding InstallationCompletedCount}" Foreground="{DynamicResource AgenAccentBrush}" /><TextBlock Classes="statLabel" Text="{DynamicResource Install.Completed}" /></StackPanel></Border>
      <Border Grid.Column="1" Classes="tile"><StackPanel><TextBlock Classes="statValue" Text="{Binding InstallationRemainingCount}" /><TextBlock Classes="statLabel" Text="{DynamicResource Install.Remaining}" /></StackPanel></Border>
      <Border Grid.Column="2" Classes="tile"><StackPanel><TextBlock Classes="statValue failedMetric" Classes.hasFailures="{Binding !!InstallationFailedCount}" Text="{Binding InstallationFailedCount}" /><TextBlock Classes="statLabel" Text="{DynamicResource Install.Failed}" /></StackPanel></Border>
    </Grid>

    <StackPanel>
      <TextBlock Classes="sectionHeader" Text="{DynamicResource Install.InstallationQueue}" />
      <Border Classes="group">
        <ItemsControl ItemsSource="{Binding InstallationItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:InstallationRowViewModel">
              <Border Classes="row" Padding="14,10">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">
                  <views:AppRowLogoView VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Classes="rowTitle" Text="{Binding Name}" />
                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource AgenMutedBrush}" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{DynamicResource AgenMutedBrush}" FontSize="13" VerticalAlignment="Center" />
                  <Button Grid.Column="3" Classes="plain" Content="{DynamicResource Install.Retry}" IsVisible="{Binding CanRetry}" Click="RetryButton_OnClick" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Classes="glyph" Text="&#xE72E;" FontSize="13" Foreground="{DynamicResource AgenMutedBrush}" />
      <TextBlock Classes="hint" Text="{DynamicResource Install.PackagesAreResolvedThroughExact}" VerticalAlignment="Center" />
    </StackPanel>
  </StackPanel>
</UserControl>
