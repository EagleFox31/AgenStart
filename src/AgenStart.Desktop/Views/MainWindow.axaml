<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AgenStart.Desktop.ViewModels"
        xmlns:views="using:AgenStart.Desktop.Views"
        x:Class="AgenStart.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        mc:Ignorable="d"
        Title="AgenStart"
        Width="1440"
        Height="920"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Classes="tabBar">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20" Margin="20,0,16,0">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="26" Height="26" CornerRadius="7" ClipToBounds="True" VerticalAlignment="Center"><Image Source="avares://AgenStart.Desktop/Assets/agenstart-app-icon.png" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" /></Border>
          <TextBlock Text="AgenStart" Foreground="{DynamicResource AgenBrandTextBrush}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Shell.ByAgenStudio}" />
        </StackPanel>

        <!-- Scrolls only if a long translation ever overflows the minimum window width. -->
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding FlowTabs}" AutomationProperties.Name="{DynamicResource Shell.Setup}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:NavigationTabViewModel">
                <Button Classes="tab" Classes.active="{Binding IsActive}" Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding Label}">
                  <TextBlock Classes="tabLabel" Text="{Binding Label}" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <ItemsControl Grid.Column="2" ItemsSource="{Binding UtilityTabs}" AutomationProperties.Name="{DynamicResource Shell.General}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NavigationTabViewModel">
              <Button Classes="tab icon" Classes.active="{Binding IsActive}" Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding Label}" ToolTip.Tip="{Binding Label}">
                <TextBlock Classes="tabIcon" Text="{Binding Icon}" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Background="{DynamicResource AgenSurfaceBrush}">
      <ScrollViewer x:Name="MainScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageHost" MaxWidth="920" Margin="48,40,48,56" HorizontalAlignment="Stretch">
          <Panel IsVisible="{Binding IsOverview}"><views:OverviewView x:Name="OverviewControl" DataContext="{Binding Overview}" /></Panel>

          <Panel IsVisible="{Binding IsYourPc}"><views:YourPcView x:Name="YourPcControl" DataContext="{Binding Overview}" /></Panel>

          <views:UsageProfilesView x:Name="UsageProfilesControl" IsVisible="{Binding IsUsageProfile}" />

          <Panel IsVisible="{Binding IsRecommendations}"><views:RecommendationsView x:Name="RecommendationsControl" DataContext="{Binding RecommendationsStep}" /></Panel>

          <Panel IsVisible="{Binding IsReview}"><views:ReviewView x:Name="ReviewControl" DataContext="{Binding Review}" /></Panel>

          <Panel IsVisible="{Binding IsInstallationStep}"><views:InstallationView x:Name="InstallationControl" DataContext="{Binding Installation}" /></Panel>

          <Panel IsVisible="{Binding IsReport}"><views:ReportView x:Name="ReportControl" DataContext="{Binding Report}" /></Panel>

          <!-- DataContext (local experience) is set in code-behind; visibility stays on the wrapping panel. -->
          <Panel IsVisible="{Binding IsHistory}"><views:HistoryView x:Name="HistoryControl" /></Panel>

          <Panel IsVisible="{Binding IsSettings}"><views:SettingsView x:Name="SettingsControl" /></Panel>
        </Grid>
      </ScrollViewer>

      <Border x:Name="RecommendationStickyHeader"
              IsVisible="False"
              Background="{DynamicResource AgenRecommendationStickyBrush}"
              BorderBrush="{DynamicResource AgenSeparatorBrush}"
              BorderThickness="0,0,0,1"
              Padding="48,12"
              VerticalAlignment="Top"
              HorizontalAlignment="Stretch">
        <Grid MaxWidth="920" ColumnDefinitions="*,Auto" ColumnSpacing="24">
          <TextBlock Text="{DynamicResource Shell.RecommendedForThisPC}"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource AgenTextBrush}"
                     VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="{Binding RecommendationsStep.RecommendationCountText}"
                       Foreground="{DynamicResource AgenMutedBrush}"
                       FontSize="12.5"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding RecommendationsStep.SelectedCountText}"
                       Foreground="{DynamicResource AgenAccentBrush}"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
