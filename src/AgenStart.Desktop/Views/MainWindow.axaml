<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AgenStart.Desktop.ViewModels"
        xmlns:views="using:AgenStart.Desktop.Views"
        x:Class="AgenStart.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        mc:Ignorable="d"
        Title="AgenStart"
        Width="1600"
        Height="1000"
        MinWidth="1100"
        MinHeight="720">
  <Grid ColumnDefinitions="280,*">
    <Border Grid.Column="0" Background="{StaticResource AgenNavBrush}">
      <Grid RowDefinitions="Auto,*,Auto" Margin="0,30,0,24">
        <StackPanel Margin="30,0,20,28">
          <TextBlock Text="AgenStart" Foreground="White" FontSize="29" FontWeight="SemiBold" />
          <TextBlock Text="BY AGENSTUDIO" Foreground="{StaticResource AgenAccentBrush}" FontSize="11" FontWeight="SemiBold" LetterSpacing="2.4" Margin="0,5,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="1">
          <Grid>
            <Border Classes="navStripe" IsVisible="{Binding IsOverview}" />
            <Button x:Name="OverviewButton" Classes="nav" Classes.active="{Binding IsOverview}" Tag="Overview" Click="NavButton_OnClick"><StackPanel Orientation="Horizontal" Spacing="0"><TextBlock Classes="navIcon" Text="⌂" /><TextBlock Classes="navLabel" Text="Overview" /></StackPanel></Button>
          </Grid>
          <Grid>
            <Border Classes="navStripe" IsVisible="{Binding IsYourPc}" />
            <Button x:Name="YourPcButton" Classes="nav" Classes.active="{Binding IsYourPc}" Tag="YourPc" Click="NavButton_OnClick"><StackPanel Orientation="Horizontal" Spacing="0"><TextBlock Classes="navIcon" Text="▣" /><TextBlock Classes="navLabel" Text="Your PC" /></StackPanel></Button>
          </Grid>
          <Grid>
            <Border Classes="navStripe" IsVisible="{Binding IsUsageProfile}" />
            <Button x:Name="UsageProfileButton" Classes="nav" Classes.active="{Binding IsUsageProfile}" Tag="UsageProfile" Click="NavButton_OnClick"><StackPanel Orientation="Horizontal" Spacing="0"><TextBlock Classes="navIcon" Text="○" /><TextBlock Classes="navLabel" Text="Usage profile" /></StackPanel></Button>
          </Grid>
          <Grid>
            <Border Classes="navStripe" IsVisible="{Binding IsRecommendations}" />
            <Button x:Name="RecommendationsButton" Classes="nav" Classes.active="{Binding IsRecommendations}" Tag="Recommendations" Click="NavButton_OnClick"><StackPanel Orientation="Horizontal" Spacing="0"><TextBlock Classes="navIcon" Text="✦" /><TextBlock Classes="navLabel" Text="Recommendations" /></StackPanel></Button>
          </Grid>
          <Grid>
            <Border Classes="navStripe" IsVisible="{Binding IsReview}" />
            <Button x:Name="ReviewButton" Classes="nav" Classes.active="{Binding IsReview}" Tag="Review" Click="NavButton_OnClick"><StackPanel Orientation="Horizontal" Spacing="0"><TextBlock Classes="navIcon" Text="✓" /><TextBlock Classes="navLabel" Text="Confirm" /></StackPanel></Button>
          </Grid>
          <Grid>
            <Border Classes="navStripe" IsVisible="{Binding IsInstallationStep}" />
            <Button x:Name="InstallationButton" Classes="nav" Classes.active="{Binding IsInstallationStep}" Tag="Installation" Click="NavButton_OnClick"><StackPanel Orientation="Horizontal" Spacing="0"><TextBlock Classes="navIcon" Text="↓" /><TextBlock Classes="navLabel" Text="Installation" /></StackPanel></Button>
          </Grid>
          <Grid>
            <Border Classes="navStripe" IsVisible="{Binding IsReport}" />
            <Button x:Name="ReportButton" Classes="nav" Classes.active="{Binding IsReport}" Tag="Report" Click="NavButton_OnClick"><StackPanel Orientation="Horizontal" Spacing="0"><TextBlock Classes="navIcon" Text="▤" /><TextBlock Classes="navLabel" Text="Report" /></StackPanel></Button>
          </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="1">
          <Border Height="1" Background="#35505A" Margin="20,0,20,14" />
          <Button Classes="nav" IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="0"><TextBlock Classes="navIcon" Text="↶" /><TextBlock Classes="navLabel" Text="History" /></StackPanel></Button>
          <Button Classes="nav" IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="0"><TextBlock Classes="navIcon" Text="⚙" /><TextBlock Classes="navLabel" Text="Settings" /></StackPanel></Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Background="{StaticResource AgenSurfaceBrush}">
      <ScrollViewer x:Name="MainScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Margin="72,62,72,54">
          <views:OverviewView x:Name="OverviewControl" IsVisible="{Binding IsOverview}" />

          <views:YourPcView x:Name="YourPcControl" IsVisible="{Binding IsYourPc}" MaxWidth="1120" HorizontalAlignment="Left" />

          <views:UsageProfilesView x:Name="UsageProfilesControl" IsVisible="{Binding IsUsageProfile}" MaxWidth="1120" HorizontalAlignment="Left" />

          <views:RecommendationsView x:Name="RecommendationsControl" IsVisible="{Binding IsRecommendations}" MaxWidth="1160" HorizontalAlignment="Left" />

          <views:ReviewView x:Name="ReviewControl" IsVisible="{Binding IsReview}" MaxWidth="1160" HorizontalAlignment="Left" />

          <views:InstallationView x:Name="InstallationControl" IsVisible="{Binding IsInstallationStep}" MaxWidth="1160" HorizontalAlignment="Left" />

          <views:ReportView x:Name="ReportControl" IsVisible="{Binding IsReport}" MaxWidth="1160" HorizontalAlignment="Left" />
        </Grid>
      </ScrollViewer>

      <Border x:Name="RecommendationStickyHeader"
              IsVisible="False"
              Background="{StaticResource AgenRecommendationStickyBrush}"
              BorderBrush="{StaticResource AgenDividerBrush}"
              BorderThickness="0,0,0,1"
              Padding="0,13"
              Margin="72,0,72,0"
              VerticalAlignment="Top"
              HorizontalAlignment="Stretch">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
          <TextBlock Text="Recommended for this PC"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource AgenTextBrush}"
                     VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="{Binding RecommendationCount, StringFormat='{}{0} apps'}"
                       Foreground="{StaticResource AgenMutedBrush}"
                       FontSize="12"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} selected'}"
                       Foreground="{StaticResource AgenTealBrush}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
