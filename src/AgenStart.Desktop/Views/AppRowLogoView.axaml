<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgenStart.Desktop.ViewModels"
             x:Class="AgenStart.Desktop.Views.AppRowLogoView"
             x:DataType="vm:IAppRowLogo"
             Width="32" Height="32">
  <Border CornerRadius="{DynamicResource AgenSmallRadius}" Background="{DynamicResource AgenLogoTileBrush}">
    <Grid>
      <TextBlock IsVisible="{Binding ShowInitials}" Text="{Binding Initials}" Foreground="{DynamicResource AgenAccentBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <Image IsVisible="{Binding HasLogo}" Source="{Binding IconSource}" Stretch="Uniform" Margin="5" />
    </Grid>
  </Border>
</UserControl>
