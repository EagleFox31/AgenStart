<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgenStart.Desktop.ViewModels"
             x:Class="AgenStart.Desktop.Views.OverviewView"
             xmlns:steps="using:AgenStart.Desktop.ViewModels.Steps"
             x:DataType="steps:OverviewViewModel">
  <StackPanel Spacing="24">
    <Border Classes="hero">
      <StackPanel>
        <TextBlock Classes="eyebrow" Text="{DynamicResource Overview.Overview}" />
        <TextBlock Classes="pageTitle" Text="{DynamicResource Overview.LetSPrepareThisPC}" Margin="0,6,0,0" />
        <TextBlock Classes="subtitle" Text="{DynamicResource Overview.AgenStartInspectsThisMachineLocally}" MaxWidth="600" HorizontalAlignment="Left" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,22,0,0">
          <Button Classes="primary large" Click="AnalyzeButton_OnClick" Content="{DynamicResource Overview.AnalyseThisPC}" />
          <Button x:Name="ImportSetupButton" Classes="secondary large" Content="{DynamicResource Overview.ImportASetup}" Click="ImportSetupButton_OnClick" />
        </StackPanel>
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" MaxWidth="360" HorizontalAlignment="Left" Margin="0,18,0,0" />
        <TextBlock x:Name="ImportStatusText" Classes="hint" IsVisible="False" Margin="0,12,0,0" />
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
      <Border Classes="tile">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
          <Border Classes="statusCircle"><TextBlock Text="&#xE73E;" /></Border>
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding StatusTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusMessage}" Classes="rowHint" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="1" Classes="tile">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
          <Border Classes="iconTile" Width="44" Height="44" CornerRadius="22" VerticalAlignment="Top"><TextBlock Classes="glyph" Text="&#xE72E;" FontSize="17" /></Border>
          <StackPanel Grid.Column="1">
            <TextBlock Text="{DynamicResource Overview.MachineAnalysisStaysOnThis}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource Overview.YouStayInControlOf}" Classes="rowHint" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <StackPanel>
      <TextBlock Classes="sectionHeader" Text="{DynamicResource Overview.HowItWorks}" />
      <Border Classes="group">
        <StackPanel>
          <Border Classes="row"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="14"><Border Classes="iconTile"><TextBlock Classes="glyph" Text="&#xE977;" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Classes="rowTitle" Text="{DynamicResource Overview.AnalyseThisPC}" /><TextBlock Classes="rowHint" Text="{DynamicResource Overview.AReadOnlyScanOf}" /></StackPanel></Grid></Border>
          <Border Classes="row"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="14"><Border Classes="iconTile"><TextBlock Classes="glyph" Text="&#xE77B;" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Classes="rowTitle" Text="{DynamicResource Overview.TellUsHowYouUse}" /><TextBlock Classes="rowHint" Text="{DynamicResource Overview.PickOneOrMoreUsage}" /></StackPanel></Grid></Border>
          <Border Classes="row"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="14"><Border Classes="iconTile"><TextBlock Classes="glyph" Text="&#xE734;" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Classes="rowTitle" Text="{DynamicResource Overview.ReviewTheRecommendations}" /><TextBlock Classes="rowHint" Text="{DynamicResource Overview.KeepTheEssentialsAddThe}" /></StackPanel></Grid></Border>
          <Border Classes="row"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="14"><Border Classes="iconTile"><TextBlock Classes="glyph" Text="&#xE930;" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Classes="rowTitle" Text="{DynamicResource Overview.ConfirmAndInstall}" /><TextBlock Classes="rowHint" Text="{DynamicResource Overview.NothingIsInstalledUntilYou}" /></StackPanel></Grid></Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
