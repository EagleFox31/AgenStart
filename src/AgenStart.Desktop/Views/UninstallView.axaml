<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:steps="using:AgenStart.Desktop.ViewModels.Steps"
             x:Class="AgenStart.Desktop.Views.UninstallView"
             x:DataType="steps:UninstallViewModel">
  <!-- Read-only in this version: the page lists and explains, it never acts on a program.
       The plan below is a description; its checkboxes only change the in-memory selection. -->
  <UserControl.Resources>
    <DataTemplate x:Key="PlanItemTemplate" x:DataType="steps:UninstallPlanItemViewModel">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,4">
        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" AutomationProperties.Name="{Binding Target}" />
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="{Binding Target}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Border Classes="statusBadge" Background="{DynamicResource AgenFillBrush}"><TextBlock Text="{Binding KindText}" Foreground="{DynamicResource AgenText3Brush}" /></Border>
            <Border Classes="statusBadge" Background="{DynamicResource AgenFillBrush}"><TextBlock Text="{Binding ClassText}" Foreground="{DynamicResource AgenText3Brush}" /></Border>
            <Border Classes="statusBadge" Background="{DynamicResource AgenFillBrush}"><TextBlock Text="{Binding ConfidenceText}" Foreground="{DynamicResource AgenText3Brush}" /></Border>
            <Border Classes="statusBadge" Background="{DynamicResource AgenFillBrush}" IsVisible="{Binding RequiresElevation}"><TextBlock Text="{DynamicResource Uninstall.Plan.NeedsAdmin}" Foreground="{DynamicResource AgenText3Brush}" /></Border>
          </StackPanel>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="{DynamicResource AgenMutedBrush}" FontSize="13" VerticalAlignment="Top" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel Spacing="24">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel>
        <TextBlock Classes="pageTitle" Text="{DynamicResource Uninstall.Title}" />
        <TextBlock Classes="subtitle" Text="{DynamicResource Uninstall.Subtitle}" Margin="0,6,0,0" />
      </StackPanel>
      <Button Grid.Column="1" Classes="secondary" Content="{DynamicResource Uninstall.Refresh}" Command="{Binding RefreshCommand}" VerticalAlignment="Bottom" />
    </Grid>

    <Border Classes="notice" IsVisible="{Binding HasNotice}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <TextBlock Classes="glyph" Text="&#xE7BA;" Foreground="{DynamicResource AgenBadgeWarningBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
        <TextBlock Grid.Column="1" Classes="rowHint" Text="{Binding Notice}" TextWrapping="Wrap" Margin="0" />
      </Grid>
    </Border>

    <Grid ColumnDefinitions="*,300" ColumnSpacing="20">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="sectionHeader" Text="{DynamicResource Uninstall.Programs}" />
          <TextBlock Grid.Column="1" Classes="rowCaption" Text="{Binding HeaderText}" VerticalAlignment="Center" Margin="0,0,4,8" />
        </Grid>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBox Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="{DynamicResource Uninstall.Search}" AutomationProperties.Name="{DynamicResource Uninstall.Search}" />
          <Border Grid.Column="1" Classes="segmented" VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Uninstall.SortBy}">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Classes="segment" Classes.active="{Binding IsSortByName}" Command="{Binding SortByNameCommand}" Content="{DynamicResource Uninstall.Sort.Name}" />
              <Button Classes="segment" Classes.active="{Binding IsSortByPublisher}" Command="{Binding SortByPublisherCommand}" Content="{DynamicResource Uninstall.Sort.Publisher}" />
              <Button Classes="segment" Classes.active="{Binding IsSortBySize}" Command="{Binding SortBySizeCommand}" Content="{DynamicResource Uninstall.Sort.Size}" />
              <Button Classes="segment" Classes.active="{Binding IsSortByDate}" Command="{Binding SortByDateCommand}" Content="{DynamicResource Uninstall.Sort.Date}" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Classes="group">
          <Grid>
            <ListBox ItemsSource="{Binding Programs}" SelectedItem="{Binding SelectedProgram, Mode=TwoWay}" IsVisible="{Binding ShowList}" MaxHeight="560" Background="Transparent" BorderThickness="0" Padding="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="steps:UninstallProgramRowViewModel">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" Margin="2,4">
                    <StackPanel>
                      <TextBlock Classes="rowTitle" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="rowHint" Text="{Binding Caption}" TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                        <Border Classes="statusBadge" Background="{DynamicResource AgenFillBrush}" HorizontalAlignment="Left"><TextBlock Text="{Binding SourceText}" Foreground="{DynamicResource AgenText3Brush}" /></Border>
                        <Border Classes="statusBadge" Background="{DynamicResource AgenFillBrush}" HorizontalAlignment="Left"><TextBlock Text="{Binding ScopeText}" Foreground="{DynamicResource AgenText3Brush}" /></Border>
                      </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="{DynamicResource AgenMutedBrush}" FontSize="13" TextAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Border IsVisible="{Binding IsLoading}" Padding="20,28">
              <StackPanel Spacing="10" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="160" />
                <TextBlock Classes="rowHint" Text="{DynamicResource Uninstall.Loading}" TextAlignment="Center" />
              </StackPanel>
            </Border>

            <Border IsVisible="{Binding ShowNoMatch}" Padding="20,28">
              <StackPanel Spacing="10" HorizontalAlignment="Center">
                <Border Classes="iconTile" HorizontalAlignment="Center" Width="44" Height="44"><TextBlock Classes="glyph" Text="&#xE74D;" FontSize="20" /></Border>
                <TextBlock Classes="rowHint" Text="{Binding NoMatchText}" TextAlignment="Center" MaxWidth="380" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </StackPanel>

      <StackPanel Grid.Column="1" Spacing="12">
        <Border Classes="tile" IsVisible="{Binding !HasSelection}">
          <TextBlock Classes="rowHint" Text="{DynamicResource Uninstall.SelectHint}" Margin="0" />
        </Border>
        <Border Classes="tile" IsVisible="{Binding HasSelection}">
          <StackPanel Spacing="12">
            <TextBlock Text="{Binding SelectedProgram.DisplayName}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
            <Border Height="1" Background="{DynamicResource AgenSeparatorBrush}" />
            <StackPanel><TextBlock Classes="rowCaption" Text="{DynamicResource Uninstall.Detail.Publisher}" /><TextBlock Text="{Binding SelectedProgram.Publisher}" TextWrapping="Wrap" /></StackPanel>
            <StackPanel><TextBlock Classes="rowCaption" Text="{DynamicResource Uninstall.Detail.Version}" /><TextBlock Text="{Binding SelectedProgram.Version}" TextWrapping="Wrap" /></StackPanel>
            <StackPanel><TextBlock Classes="rowCaption" Text="{DynamicResource Uninstall.Detail.Location}" /><TextBlock Text="{Binding SelectedProgram.InstallLocation}" TextWrapping="Wrap" /></StackPanel>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel><TextBlock Classes="rowCaption" Text="{DynamicResource Uninstall.Detail.Size}" /><TextBlock Text="{Binding SelectedProgram.SizeText}" /></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Classes="rowCaption" Text="{DynamicResource Uninstall.Detail.InstallDate}" /><TextBlock Text="{Binding SelectedProgram.InstallDateText}" /></StackPanel>
            </Grid>
            <StackPanel><TextBlock Classes="rowCaption" Text="{DynamicResource Uninstall.Detail.Installer}" /><TextBlock Text="{Binding SelectedProgram.InstallerKindText}" TextWrapping="Wrap" /></StackPanel>
            <StackPanel><TextBlock Classes="rowCaption" Text="{DynamicResource Uninstall.Detail.Silent}" /><TextBlock Text="{Binding SelectedProgram.SilentUninstallText}" TextWrapping="Wrap" /></StackPanel>
            <Border Height="1" Background="{DynamicResource AgenSeparatorBrush}" />
            <TextBlock Classes="hint" Text="{DynamicResource Uninstall.LaterNote}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <Border Classes="tile" IsVisible="{Binding HasSelection}">
      <StackPanel Spacing="14">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
          <TextBlock Classes="sectionHeader" Text="{DynamicResource Uninstall.Plan.Title}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="secondary" Content="{DynamicResource Uninstall.Plan.Prepare}" Command="{Binding PreparePlanCommand}" />
          <Button Grid.Column="2" Classes="secondary" Content="{DynamicResource Uninstall.Plan.Export}" Command="{Binding ExportPlanCommand}" IsVisible="{Binding HasPlan}" />
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsPlanning}">
          <ProgressBar IsIndeterminate="True" Width="120" VerticalAlignment="Center" />
          <TextBlock Classes="rowHint" Text="{DynamicResource Uninstall.Plan.Preparing}" Margin="0" />
        </StackPanel>

        <TextBlock Classes="rowHint" Text="{Binding PlanNotice}" IsVisible="{Binding HasPlanNotice}" TextWrapping="Wrap" Margin="0" />

        <ContentControl Content="{Binding CurrentPlan}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="steps:UninstallPlanViewModel">
              <StackPanel Spacing="14">
                <Border Classes="notice" IsVisible="{Binding HasRunning}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <TextBlock Classes="glyph" Text="&#xE7BA;" Foreground="{DynamicResource AgenBadgeWarningBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                    <TextBlock Grid.Column="1" Classes="rowHint" Text="{Binding RunningText}" TextWrapping="Wrap" Margin="0" />
                  </Grid>
                </Border>

                <StackPanel Spacing="4">
                  <TextBlock Classes="rowCaption" Text="{DynamicResource Uninstall.Plan.Official}" />
                  <TextBlock Text="{Binding StrategyText}" TextWrapping="Wrap" />
                  <SelectableTextBlock Classes="rowHint" Text="{Binding CommandPreview}" IsVisible="{Binding HasCommandPreview}" TextWrapping="Wrap" Margin="0" />
                  <TextBlock Classes="rowHint" Text="{DynamicResource Uninstall.Plan.Elevation}" IsVisible="{Binding OfficialRequiresElevation}" Margin="0" />
                </StackPanel>

                <Border Height="1" Background="{DynamicResource AgenSeparatorBrush}" />

                <StackPanel Spacing="6">
                  <TextBlock Classes="rowCaption" Text="{DynamicResource Uninstall.Plan.Leftovers}" />
                  <ItemsControl ItemsSource="{Binding Leftovers}" ItemTemplate="{StaticResource PlanItemTemplate}" IsVisible="{Binding HasLeftovers}" />
                  <TextBlock Classes="rowHint" Text="{DynamicResource Uninstall.Plan.NoLeftovers}" IsVisible="{Binding !HasLeftovers}" Margin="0" />
                  <TextBlock Classes="rowHint" Text="{Binding LowConfidenceText}" IsVisible="{Binding HasLowConfidence}" TextWrapping="Wrap" Margin="0" />
                  <TextBlock Classes="rowHint" Text="{Binding SkippedText}" IsVisible="{Binding HasSkipped}" TextWrapping="Wrap" Margin="0" />
                </StackPanel>

                <StackPanel Spacing="6" IsVisible="{Binding HasProtected}">
                  <Border Height="1" Background="{DynamicResource AgenSeparatorBrush}" />
                  <TextBlock Classes="rowCaption" Text="{DynamicResource Uninstall.Plan.Protected}" />
                  <TextBlock Classes="rowHint" Text="{DynamicResource Uninstall.Plan.ProtectedHint}" TextWrapping="Wrap" Margin="0" />
                  <ItemsControl ItemsSource="{Binding ProtectedItems}" ItemTemplate="{StaticResource PlanItemTemplate}" />
                  <Border Classes="notice" IsVisible="{Binding HasProtectedSelected}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                      <TextBlock Classes="glyph" Text="&#xE7BA;" Foreground="{DynamicResource AgenBadgeWarningBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                      <TextBlock Grid.Column="1" Classes="rowHint" Text="{DynamicResource Uninstall.Plan.ProtectedWarning}" TextWrapping="Wrap" Margin="0" />
                    </Grid>
                  </Border>
                </StackPanel>

                <Border Height="1" Background="{DynamicResource AgenSeparatorBrush}" />
                <TextBlock Classes="rowCaption" Text="{Binding SelectionText}" />
                <TextBlock Classes="rowHint" Text="{DynamicResource Uninstall.Plan.LargeSelection}" IsVisible="{Binding ExceedsVolumeThresholds}" TextWrapping="Wrap" Margin="0" />              </StackPanel>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

        <TextBlock Classes="hint" Text="{DynamicResource Uninstall.Plan.ReadOnlyNote}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
