<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgenStart.Desktop.ViewModels"
             xmlns:views="using:AgenStart.Desktop.Views"
             x:Class="AgenStart.Desktop.Views.ReportView"
             xmlns:steps="using:AgenStart.Desktop.ViewModels.Steps"
             x:DataType="steps:ReportViewModel">
  <StackPanel Spacing="24">
    <Border Classes="hero">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
        <Border Classes="statusCircle" IsVisible="{Binding !ReportFailedCount}" Background="{DynamicResource AgenCardBrush}"><TextBlock Text="&#xE73E;" /></Border>
        <Border Classes="statusCircle warning" IsVisible="{Binding !!ReportFailedCount}" Background="{DynamicResource AgenCardBrush}"><TextBlock Text="&#xE7BA;" /></Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Classes="pageTitle" Text="{Binding ReportTitle}" />
          <TextBlock Classes="subtitle" Text="{Binding ReportStatus}" Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
          <TextBlock Classes="rowCaption" Text="Completed at" TextAlignment="Right" />
          <TextBlock Text="{Binding ReportCompletedAt}" FontWeight="SemiBold" TextAlignment="Right" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
      <Border Classes="tile"><StackPanel><TextBlock Classes="statValue" Text="{Binding ReportProcessedCount}" /><TextBlock Classes="statLabel" Text="applications processed" /></StackPanel></Border>
      <Border Grid.Column="1" Classes="tile"><StackPanel><TextBlock Classes="statValue" Text="{Binding ReportInstalledCount}" Foreground="{DynamicResource AgenAccentBrush}" /><TextBlock Classes="statLabel" Text="installed" /></StackPanel></Border>
      <Border Grid.Column="2" Classes="tile"><StackPanel><TextBlock Classes="statValue" Text="{Binding ReportAlreadyInstalledCount}" /><TextBlock Classes="statLabel" Text="already installed" /></StackPanel></Border>
      <Border Grid.Column="3" Classes="tile"><StackPanel><TextBlock Classes="statValue failedMetric" Classes.hasFailures="{Binding !!ReportFailedCount}" Text="{Binding ReportFailedCount}" /><TextBlock Classes="statLabel" Text="failed" /></StackPanel></Border>
    </Grid>

    <Border Classes="notice" IsVisible="{Binding ReportRequiresReboot}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <TextBlock Classes="glyph" Text="&#xE777;" Foreground="{DynamicResource AgenBadgeWarningBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
        <StackPanel Grid.Column="1">
          <TextBlock Text="Restart recommended" FontWeight="SemiBold" />
          <TextBlock Classes="rowHint" Text="One or more installed applications require Windows to restart before all features become available." />
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel>
      <TextBlock Classes="sectionHeader" Text="Installation results" />
      <Border Classes="group">
        <ItemsControl ItemsSource="{Binding ReportItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ReportRowViewModel">
              <Border Classes="row" Padding="14,10">
                <Grid ColumnDefinitions="Auto,*,Auto,140" ColumnSpacing="14">
                  <views:AppRowLogoView VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="rowTitle" Text="{Binding Name}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Result}" FontSize="13" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding InstalledVersion}" Foreground="{DynamicResource AgenMutedBrush}" FontSize="13" TextAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="ExportSetupButton" Classes="secondary large" Content="Export this setup" IsEnabled="False" Click="ExportSetupButton_OnClick" />
      <Button Classes="primary large" Content="Finish" Click="FinishButton_OnClick" />
    </StackPanel>
  </StackPanel>
</UserControl>
