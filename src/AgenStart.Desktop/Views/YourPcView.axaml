<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgenStart.Desktop.ViewModels"
             x:Class="AgenStart.Desktop.Views.YourPcView"
             x:DataType="vm:MainWindowViewModel">
  <StackPanel>
    <TextBlock Classes="eyebrow" Text="YOUR PC" Margin="0,0,0,22" />
    <TextBlock Classes="pageTitle" Text="Your PC" />
    <TextBlock Classes="subtitle" Text="AgenStart detected the essentials locally." Margin="0,13,0,0" />
    <Border Height="1" Background="{StaticResource AgenDividerBrush}" Margin="0,30,0,26" />
    <Grid ColumnDefinitions="1.35*,0.65*" ColumnSpacing="52">
      <StackPanel Grid.Column="0">
        <Border Classes="dataRow"><Grid ColumnDefinitions="46,*,150" ColumnSpacing="16"><TextBlock Classes="rowIcon" Text="▣" FontSize="19" /><TextBlock Grid.Column="1" Text="{Binding OperatingSystem}" FontSize="17" /><Border Grid.Column="2" Classes="statusBadge success"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="✓" /><TextBlock Text="Detected" /></StackPanel></Border></Grid></Border>
        <Border Classes="dataRow"><Grid ColumnDefinitions="46,*,150" ColumnSpacing="16"><TextBlock Classes="rowIcon" Text="◉" FontSize="19" /><TextBlock Grid.Column="1" Text="{Binding Cpu}" FontSize="17" /><Border Grid.Column="2" Classes="statusBadge success"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="✓" /><TextBlock Text="Detected" /></StackPanel></Border></Grid></Border>
        <Border Classes="dataRow"><Grid ColumnDefinitions="46,*,150" ColumnSpacing="16"><TextBlock Classes="rowIcon" Text="▥" FontSize="19" /><TextBlock Grid.Column="1" Text="{Binding Memory}" FontSize="17" /><Border Grid.Column="2" Classes="statusBadge success"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="✓" /><TextBlock Text="Available" /></StackPanel></Border></Grid></Border>
        <Border Classes="dataRow"><Grid ColumnDefinitions="46,*,150" ColumnSpacing="16"><TextBlock Classes="rowIcon" Text="◇" FontSize="19" /><TextBlock Grid.Column="1" Text="{Binding Gpu}" FontSize="17" /><Border Grid.Column="2" Classes="statusBadge success"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="✓" /><TextBlock Text="Detected" /></StackPanel></Border></Grid></Border>
        <Border Classes="dataRow"><Grid ColumnDefinitions="46,*,150" ColumnSpacing="16"><TextBlock Classes="rowIcon" Text="▰" FontSize="19" /><TextBlock Grid.Column="1" Text="{Binding SystemDrive}" FontSize="17" /><Border Grid.Column="2" Classes="statusBadge success"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="✓" /><TextBlock Text="Available" /></StackPanel></Border></Grid></Border>
        <Border Classes="dataRow"><Grid ColumnDefinitions="46,*,150" ColumnSpacing="16"><TextBlock Classes="rowIcon" Text="◌" FontSize="19" /><TextBlock Grid.Column="1" Text="{Binding FreeSpace}" FontSize="17" /><Border Grid.Column="2" Classes="statusBadge success"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="✓" /><TextBlock Text="Available" /></StackPanel></Border></Grid></Border>
        <Border Classes="dataRow"><Grid ColumnDefinitions="46,*,150" ColumnSpacing="16"><TextBlock Classes="rowIcon" Text="64" FontSize="13" FontWeight="Bold" /><TextBlock Grid.Column="1" Text="{Binding Architecture}" FontSize="17" /><Border Grid.Column="2" Classes="statusBadge success"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="✓" /><TextBlock Text="Supported" /></StackPanel></Border></Grid></Border>
        <Border Classes="dataRow"><Grid ColumnDefinitions="46,*,150" ColumnSpacing="16"><TextBlock Classes="rowIcon" Text="⬡" FontSize="19" /><TextBlock Grid.Column="1" Text="{Binding WinGet, StringFormat='WinGet · {0}'}" FontSize="17" /><Border Grid.Column="2" Classes="statusBadge success"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="✓" /><TextBlock Text="Available" /></StackPanel></Border></Grid></Border>
        <Border Classes="dataRow"><Grid ColumnDefinitions="46,*,150" ColumnSpacing="16"><TextBlock Classes="rowIcon" Text="i" FontSize="19" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding WinGetVersion, StringFormat='WinGet version {0}'}" FontSize="17" /><Border Grid.Column="2" Classes="statusBadge success"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="✓" /><TextBlock Text="Detected" /></StackPanel></Border></Grid></Border>
        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,26,0,0">
          <Button Classes="primary" Content="Choose usage profile" Click="ContinueButton_OnClick" />
          <Button Classes="secondary" Content="Refresh analysis" Click="RefreshButton_OnClick" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="310" Spacing="12">
        <Border Width="74" Height="74" CornerRadius="37" BorderThickness="2" BorderBrush="{StaticResource AgenTealBrush}" HorizontalAlignment="Center"><TextBlock Text="✓" FontSize="35" Foreground="{StaticResource AgenTealBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        <TextBlock Text="{Binding StatusTitle}" FontSize="25" FontWeight="SemiBold" TextAlignment="Center" Margin="0,8,0,0" />
        <TextBlock Text="{Binding StatusMessage}" Classes="subtitle" TextWrapping="Wrap" TextAlignment="Center" />
      </StackPanel>
    </Grid>
    <Border BorderBrush="{StaticResource AgenDividerBrush}" BorderThickness="0,1,0,0" Margin="0,30,0,0" Padding="0,24,0,0"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="▱" Foreground="{StaticResource AgenTealBrush}" FontSize="21" /><TextBlock Text="{Binding AnalysisDiagnostic}" Foreground="{StaticResource AgenMutedBrush}" FontSize="14" VerticalAlignment="Center" /></StackPanel></Border>
  </StackPanel>
</UserControl>
