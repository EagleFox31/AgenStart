<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AgenStart.Desktop.ViewModels"
             x:Class="AgenStart.Desktop.Views.YourPcView"
             xmlns:steps="using:AgenStart.Desktop.ViewModels.Steps"
             x:DataType="steps:OverviewViewModel">
  <StackPanel Spacing="24">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
      <StackPanel>
        <TextBlock Classes="pageTitle" Text="{DynamicResource YourPc.YourPC}" />
        <TextBlock Classes="subtitle" Text="{DynamicResource YourPc.AgenStartDetectedTheEssentialsLocally}" Margin="0,6,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
        <Button Classes="secondary" Content="{DynamicResource YourPc.RefreshAnalysis}" Click="RefreshButton_OnClick" />
        <Button Classes="primary" Content="{DynamicResource YourPc.ChooseUsageProfile}" Click="ContinueButton_OnClick" />
      </StackPanel>
    </Grid>

    <Border Classes="tile">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
        <Border Classes="statusCircle"><TextBlock Text="&#xE73E;" /></Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding StatusMessage}" Classes="rowHint" />
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel>
      <TextBlock Classes="sectionHeader" Text="{DynamicResource YourPc.System}" />
      <Border Classes="group">
        <StackPanel>
          <Border Classes="row"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"><Border Classes="iconTile"><TextBlock Classes="glyph" Text="&#xE7F8;" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Classes="rowCaption" Text="{DynamicResource YourPc.OperatingSystem}" /><TextBlock Classes="rowTitle" Text="{Binding OperatingSystem}" /></StackPanel><Border Grid.Column="2" Classes="statusBadge success"><TextBlock Text="{DynamicResource YourPc.Detected}" /></Border></Grid></Border>
          <Border Classes="row"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"><Border Classes="iconTile"><TextBlock Classes="glyph" Text="&#xE950;" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Classes="rowCaption" Text="{DynamicResource YourPc.Processor}" /><TextBlock Classes="rowTitle" Text="{Binding Cpu}" /></StackPanel><Border Grid.Column="2" Classes="statusBadge success"><TextBlock Text="{DynamicResource YourPc.Detected}" /></Border></Grid></Border>
          <Border Classes="row"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"><Border Classes="iconTile"><TextBlock Classes="glyph" Text="&#xEEA0;" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Classes="rowCaption" Text="{DynamicResource YourPc.Memory}" /><TextBlock Classes="rowTitle" Text="{Binding Memory}" /></StackPanel><Border Grid.Column="2" Classes="statusBadge success"><TextBlock Text="{DynamicResource YourPc.Available}" /></Border></Grid></Border>
          <Border Classes="row"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"><Border Classes="iconTile"><TextBlock Classes="glyph" Text="&#xE7F4;" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Classes="rowCaption" Text="{DynamicResource YourPc.Graphics}" /><TextBlock Classes="rowTitle" Text="{Binding Gpu}" /></StackPanel><Border Grid.Column="2" Classes="statusBadge success"><TextBlock Text="{DynamicResource YourPc.Detected}" /></Border></Grid></Border>
          <Border Classes="row"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"><Border Classes="iconTile"><TextBlock Classes="glyph" Text="&#xEDA2;" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Classes="rowCaption" Text="{DynamicResource YourPc.SystemDrive}" /><TextBlock Classes="rowTitle" Text="{Binding SystemDrive}" /></StackPanel><Border Grid.Column="2" Classes="statusBadge success"><TextBlock Text="{DynamicResource YourPc.Available}" /></Border></Grid></Border>
          <Border Classes="row"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"><Border Classes="iconTile"><TextBlock Classes="glyph" Text="&#xE9F9;" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Classes="rowCaption" Text="{DynamicResource YourPc.FreeSpace}" /><TextBlock Classes="rowTitle" Text="{Binding FreeSpace}" /></StackPanel><Border Grid.Column="2" Classes="statusBadge success"><TextBlock Text="{DynamicResource YourPc.Available}" /></Border></Grid></Border>
          <Border Classes="row"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"><Border Classes="iconTile"><TextBlock Classes="glyph" Text="&#xE964;" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Classes="rowCaption" Text="{DynamicResource YourPc.Architecture}" /><TextBlock Classes="rowTitle" Text="{Binding Architecture}" /></StackPanel><Border Grid.Column="2" Classes="statusBadge success"><TextBlock Text="{DynamicResource YourPc.Supported}" /></Border></Grid></Border>
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel>
      <TextBlock Classes="sectionHeader" Text="{DynamicResource YourPc.PackageManager}" />
      <Border Classes="group">
        <StackPanel>
          <Border Classes="row"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"><Border Classes="iconTile"><TextBlock Classes="glyph" Text="&#xE7B8;" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Classes="rowCaption" Text="WinGet" /><TextBlock Classes="rowTitle" Text="{Binding WinGet, StringFormat='WinGet · {0}'}" /></StackPanel><Border Grid.Column="2" Classes="statusBadge success"><TextBlock Text="{DynamicResource YourPc.Available}" /></Border></Grid></Border>
          <Border Classes="row"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"><Border Classes="iconTile"><TextBlock Classes="glyph" Text="&#xE946;" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Classes="rowCaption" Text="{DynamicResource YourPc.Version}" /><TextBlock Classes="rowTitle" Text="{Binding WinGetVersion, StringFormat='WinGet {0}'}" /></StackPanel><Border Grid.Column="2" Classes="statusBadge success"><TextBlock Text="{DynamicResource YourPc.Detected}" /></Border></Grid></Border>
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Classes="glyph" Text="&#xE72E;" FontSize="13" Foreground="{DynamicResource AgenMutedBrush}" />
      <TextBlock Classes="hint" Text="{Binding AnalysisDiagnostic}" VerticalAlignment="Center" />
    </StackPanel>
  </StackPanel>
</UserControl>
